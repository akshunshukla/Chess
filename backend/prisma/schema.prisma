// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS — map directly to PostgreSQL ENUMs
// ============================================

enum GameStatus {
  waiting
  active
  completed
  aborted
}

enum GameResult {
  white_win
  black_win
  draw
}

enum ResultReason {
  checkmate
  resignation
  stalemate
  timeout
  server_crash
  draw_agreement
  insufficient_material
  threefold_repetition
  fifty_move_rule
  abandonment
}

enum Color {
  w
  b
}

enum AnalysisInputKind {
  pgn
  fen
}

// ============================================
// USER
// ============================================

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique @db.VarChar(30)
  email        String  @unique @db.VarChar(255)
  passwordHash String  @db.VarChar(255)
  displayName  String? @db.VarChar(50)
  rating       Int     @default(1200)

  gamesPlayed Int      @default(0)
  gamesWon    Int      @default(0)
  gamesDrawn  Int      @default(0)
  gamesLost   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  whiteGames Game[] @relation("WhitePlayer")
  blackGames Game[] @relation("BlackPlayer")

  analyses       GameAnalysis[]
  studyPlans     StudyPlan[]
  analysisInputs AnalysisInput[]

  @@index([rating])
}

// ============================================
// GAME
// ============================================

model Game {
  id String @id @default(uuid()) @db.Uuid

  whitePlayerId String @db.Uuid
  blackPlayerId String @db.Uuid

  status       GameStatus    @default(waiting)
  result       GameResult?
  resultReason ResultReason?

  timeControlSeconds Int @default(600) @map("timeControl")
  incrementSeconds   Int @default(0) @map("increment")

  pgn      String?
  finalFen String?

  whiteRatingBefore Int?
  whiteRatingAfter  Int?
  blackRatingBefore Int?
  blackRatingAfter  Int?

  startedAt DateTime? @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  whitePlayer User @relation("WhitePlayer", fields: [whitePlayerId], references: [id])
  blackPlayer User @relation("BlackPlayer", fields: [blackPlayerId], references: [id])

  moves          Move[]
  snapshots      GameSnapshot[]
  analyses       GameAnalysis[]
  studyPlanGames StudyPlanGame[]

  @@index([whitePlayerId, status, endedAt(sort: Desc), id(sort: Desc)])
  @@index([blackPlayerId, status, endedAt(sort: Desc), id(sort: Desc)])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ============================================
// MOVE — batch-inserted on game end, not during play
// ============================================

model Move {
  id     String @id @default(uuid()) @db.Uuid
  gameId String @db.Uuid

  moveNumber Int
  color      Color
  san        String @db.VarChar(10)
  uci        String @db.VarChar(10)

  fenAfter        String
  timeRemainingMs Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, moveNumber, color])
}

// ============================================
// GAME SNAPSHOT — checkpoint every 10 moves, deleted on game end
// ============================================

model GameSnapshot {
  id     String @id @default(uuid()) @db.Uuid
  gameId String @db.Uuid

  moveCount   Int
  fen         String
  movesUci    String
  whiteTimeMs Int
  blackTimeMs Int
  turn        Color

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, moveCount])
}

// ============================================
// ANALYSIS ENUMS
// ============================================

enum AnalysisStatus {
  pending
  processing
  completed
  failed
}

enum MoveCategory {
  brilliant
  best
  excellent
  good
  inaccuracy
  mistake
  blunder
  book
  forced
}

// ============================================
// IMPORTED INPUT — keeps external players out of platform accounts and Elo
// ============================================

model AnalysisInput {
  id          String            @id @default(uuid()) @db.Uuid
  ownerId     String            @db.Uuid
  kind        AnalysisInputKind

  pgn         String?

  startingFen String
  metadata    Json?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  owner    User           @relation(fields: [ownerId], references: [id])
  analyses GameAnalysis[]

  @@index([ownerId, createdAt(sort: Desc)])
}

model GameAnalysis {
  id              String  @id @default(uuid()) @db.Uuid
  gameId          String? @db.Uuid
  analysisInputId String? @db.Uuid
  requestedBy     String  @db.Uuid

  status                AnalysisStatus @default(pending)
  engineDepth           Int            @default(20)
  engineVersion         String?
  classificationVersion String         @default("review-v1")

  accuracyWhite Float?
  accuracyBlack Float?

  whiteBrilliantCount  Int @default(0)
  whiteBestCount       Int @default(0)
  whiteExcellentCount  Int @default(0)
  whiteGoodCount       Int @default(0)
  whiteInaccuracyCount Int @default(0)
  whiteMistakeCount    Int @default(0)
  whiteBlunderCount    Int @default(0)
  blackBrilliantCount  Int @default(0)
  blackBestCount       Int @default(0)
  blackExcellentCount  Int @default(0)
  blackGoodCount       Int @default(0)
  blackInaccuracyCount Int @default(0)
  blackMistakeCount    Int @default(0)
  blackBlunderCount    Int @default(0)

  attemptCount Int      @default(0)
  lastError    String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  startedAt   DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  game             Game?             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  analysisInput    AnalysisInput?    @relation(fields: [analysisInputId], references: [id], onDelete: Cascade)
  requestedByUser  User              @relation(fields: [requestedBy], references: [id])
  moveAnalyses     MoveAnalysis[]
  positionAnalysis PositionAnalysis?
  studyPlanGames   StudyPlanGame[]

  @@unique([gameId, requestedBy])
  @@unique([analysisInputId, requestedBy])
  @@index([requestedBy, status, completedAt(sort: Desc)])
  @@index([status, startedAt])
}

// ============================================
// MOVE ANALYSIS — Stockfish verdict per move
// ============================================

model MoveAnalysis {
  id             String @id @default(uuid()) @db.Uuid
  gameAnalysisId String @db.Uuid

  moveNumber Int
  color      Color
  san        String @db.VarChar(10)

  fenBefore String
  fenAfter  String

  engineBestMove String  @db.VarChar(10)
  engineBestSan  String  @db.VarChar(10)

  evalBeforeCp   Int?
  evalAfterCp    Int?
  mateBefore     Int?
  mateAfter      Int?
  engineLine     String?

  expectedScoreBefore Float
  expectedScoreAfter  Float
  expectedScoreLoss   Float

  materialDelta                 Int?

  sacrificeVerified             Boolean @default(false)
  sacrificeValue                Int?
  expectedScoreWithoutSacrifice Float?

  category MoveCategory

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  gameAnalysis GameAnalysis @relation(fields: [gameAnalysisId], references: [id], onDelete: Cascade)

  @@unique([gameAnalysisId, moveNumber, color])
}

model PositionAnalysis {
  id                 String   @id @default(uuid()) @db.Uuid
  gameAnalysisId     String   @unique @db.Uuid
  fen                String
  evalCp             Int?
  mateIn             Int?

  expectedScoreWhite Float

  bestMoveUci        String?  @db.VarChar(10)
  bestMoveSan        String?  @db.VarChar(10)
  engineLine         String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  gameAnalysis GameAnalysis @relation(fields: [gameAnalysisId], references: [id], onDelete: Cascade)
}

// ============================================
// STUDY PLAN — AI-generated improvement plan
// ============================================

enum StudyPlanStatus {
  processing
  completed
  failed
}

model StudyPlan {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  status StudyPlanStatus @default(processing)

  requestedAt    DateTime @db.Timestamptz(3)
  gamesSelected  Int
  gamesAnalyzed  Int      @default(0)
  dateRangeStart DateTime @db.Timestamptz(3)
  dateRangeEnd   DateTime @db.Timestamptz(3)

  inputSummary Json?
  planContent  Json?
  modelUsed    String? @db.VarChar(50)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user          User            @relation(fields: [userId], references: [id])
  selectedGames StudyPlanGame[]
  lastError     String?
  completedAt   DateTime?       @db.Timestamptz(3)

  @@index([userId, requestedAt(sort: Desc)])
}

model StudyPlanGame {
  studyPlanId    String  @db.Uuid
  gameId         String  @db.Uuid
  position       Int
  playerColor    Color
  gameAnalysisId String? @db.Uuid

  studyPlan    StudyPlan     @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  game         Game          @relation(fields: [gameId], references: [id], onDelete: Restrict)
  gameAnalysis GameAnalysis? @relation(fields: [gameAnalysisId], references: [id], onDelete: SetNull)

  @@id([studyPlanId, gameId])
  @@unique([studyPlanId, position])
  @@index([gameId])
  @@index([gameAnalysisId])
}
